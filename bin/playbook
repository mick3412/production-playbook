#!/usr/bin/env python3
"""One command for all four playbooks. Read-only except `add`, which only drops into an inbox."""
import csv, json, re, subprocess, sys
from pathlib import Path

BOOKS = {"影片": "production-playbook", "行銷": "marketing-playbook", "網站": "web-playbook", "開發": "engineering-playbook"}
ALIAS = {"production": "影片", "video": "影片", "製片": "影片", "marketing": "行銷", "web": "網站", "engineering": "開發", "dev": "開發"}

HELP = """playbook：查四本手冊（影片、行銷、網站、開發）
  playbook find "需求"        四本一起比對，列出每本最符合的方案和代號
  playbook plan 影片 "需求"   某一本的完整方案（2–3 個，依階段列代號）
  playbook show 影片 S8-06    看一條的完整內容
  playbook card 影片 8        看某階段的重點（加 --full 看完整清單）
  playbook add 影片 網址 "原因"  把新資料丟進收件匣，不直接改手冊
  playbook vocab 網站 [維度]   製作語彙（影片 16 維、網站 15 維）
  playbook spec 影片 卡.json [--out spec.md]   規格卡轉成精準指令（--template 取得範本）
  playbook probe 影片 footage 毛片.mp4 | breakdown 參考片.mp4   剪輯模式、拆解模式（只有影片）
  playbook blueprint [手冊] "需求" [--save]   完整計畫書（不指定手冊時用 find 最符合的那本）
  playbook strategy "目的（含期限與數字）" [--save]   產出策略卡（受眾、平台角色、短中長期內容、設計基因）
  playbook works              把策略卡拆成作品單，每張註明交給哪本手冊和下一步指令
  playbook style 新粗獷        一個風格在影片、圖片、網站的特徵、數值和寫法，加上四本標了它的項目"""


def home(book):
    f = Path.home() / ".config" / BOOKS[book] / "home"
    if not f.is_file():
        sys.exit(f"找不到{book}手冊：先在手冊資料夾跑 python3 pb.py setup")
    return Path(f.read_text().strip())


def book_of(name):
    b = ALIAS.get(name.lower(), name)
    if b not in BOOKS:
        sys.exit(f"手冊要是其中之一：{'、'.join(BOOKS)}")
    return b


def pb(book, *args):
    r = home(book)
    return subprocess.run([sys.executable, str(r / "pb.py"), *args], cwd=r, capture_output=True, text=True)


def find(words):
    q = " ".join(words)
    keys = [w.lower() for w in words]
    found = False
    for b in BOOKS:
        for line in pb(b, "plan", q).stdout.splitlines():
            m = re.match(r"## 方案 \d+：(.*)（符合度 ([\d.]+)）$", line)
            if m and float(m[2]) >= 0.15:
                print(f"{b}  {m[1]}（符合度 {m[2]}）")
                found = True
    if not found:
        print("沒有符合的配方，改列相近的做法和工具：")
        for b in BOOKS:
            hits = []
            for line in pb(b, "similar", q, "--top", "3").stdout.splitlines():
                score, rest = line.split(None, 1)
                if float(score) >= 0.05:
                    hits.append(rest)
            with open(home(b) / "data/tools.csv", encoding="utf-8") as f:
                for t in csv.DictReader(f):
                    text = " ".join((t["工具"], t["何時用"], t["做什麼"])).lower()
                    if t["狀態"] not in ("避開", "未採用") and any(k in text for k in keys):
                        hits.append(f"{t['id']}  工具：{t['工具']}（{t['狀態']}）")
            for h in hits[:6]:
                print(f"{b}  {h}")
    print('\n看某本的完整方案：playbook plan <手冊> "需求"；看一條：playbook show <手冊> <代號>')


def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(HELP); return
    cmd, rest = a[0], a[1:]
    if cmd == "find" and rest:
        find(rest)
    elif cmd == "plan" and len(rest) >= 2:
        r = pb(book_of(rest[0]), "plan", " ".join(rest[1:])); print(r.stdout or r.stderr, end="")
    elif cmd == "show" and len(rest) == 2:
        r = pb(book_of(rest[0]), "show", rest[1]); print(r.stdout or r.stderr, end="")
    elif cmd == "card" and len(rest) >= 2:
        args = ["card", rest[1]] + ([] if "--full" in rest else ["--brief"])
        r = pb(book_of(rest[0]), *args); print(r.stdout or r.stderr, end="")
    elif cmd == "add" and len(rest) >= 2:
        note = rest[2] if len(rest) > 2 else ""
        r = pb(book_of(rest[0]), "inbox", "add", rest[1], "--note", note); print(r.stdout or r.stderr, end="")
    elif cmd == "strategy" and rest:
        r = home("行銷")
        sys.exit(subprocess.call([sys.executable, str(r / "pb.py"), "strategy", "--from", " ".join(x for x in rest if x != "--save"),
                                  *(["--save"] if "--save" in rest else [])]))
    elif cmd == "blueprint" and rest:
        if rest[0] in BOOKS or rest[0].lower() in ALIAS:
            book, args = book_of(rest[0]), rest[1:]
        else:
            args = rest
            need = " ".join(x for x in args if x != "--save")
            best = None
            for b in BOOKS:
                r = subprocess.run([sys.executable, str(home(b) / "pb.py"), "plan", need, "--json"], capture_output=True, text=True)
                try:
                    o = json.loads(r.stdout)["options"]
                except Exception:
                    continue
                if o and o[0]["id"] != "自組" and (best is None or o[0]["score"] > best[1]):
                    best = (b, o[0]["score"])
            book = best[0] if best else "影片"
            print(f"（依需求選了{book}手冊）\n", flush=True)
        need = " ".join(x for x in args if x != "--save")
        sys.exit(subprocess.call([sys.executable, str(home(book) / "pb.py"), "blueprint", need, *(["--save"] if "--save" in args else [])]))
    elif cmd == "works":
        sys.exit(subprocess.call([sys.executable, str(home("行銷") / "pb.py"), "strategy", "--works"]))
    elif cmd == "style":
        name = " ".join(rest)
        subprocess.call([sys.executable, str(home("影片") / "pb.py"), "style", *([name] if name else [])])
        if name:
            print("\n## 四本標了這個風格的項目\n")
            for b in BOOKS:
                r = subprocess.run([sys.executable, str(home(b) / "pb.py"), "style", name, "--items"], capture_output=True, text=True)
                print("- " + (r.stdout.strip() or r.stderr.strip()))
    elif cmd in ("vocab", "spec", "probe") and rest:
        r = home(book_of(rest[0]))   # file paths stay relative to where the user is
        sys.exit(subprocess.call([sys.executable, str(r / "pb.py"), cmd, *rest[1:]]))
    else:
        print(HELP); sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
